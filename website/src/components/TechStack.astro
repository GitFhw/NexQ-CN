---
import { t, type WebsiteLocale } from '../i18n';

interface Props {
  locale: WebsiteLocale;
}

const { locale } = Astro.props;
const techs = [
  { icon: '🖥️', name: 'Tauri 2', role: t('Desktop Framework', locale), delay: 0 },
  { icon: '🦀', name: 'Rust', role: t('Backend & Audio', locale), delay: 50 },
  { icon: '⚛️', name: 'React 18', role: t('User Interface', locale), delay: 100 },
  { icon: '🔷', name: 'TypeScript', role: t('Type Safety', locale), delay: 150 },
  { icon: '🎨', name: 'Tailwind CSS', role: t('Styling', locale), delay: 200 },
  { icon: '🗃️', name: 'SQLite', role: t('Local Database', locale), delay: 250 },
  { icon: '🎙️', name: 'WASAPI', role: t('Audio Capture', locale), delay: 300 },
];
---

<section class="section-container">
  <div class="text-center">
    <h2 class="section-title">{t('Built with Rust for speed and safety', locale)}</h2>
    <p class="section-subtitle mx-auto text-center">
      {t('Native performance meets modern web technology.', locale)}
    </p>
  </div>

  <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-4 lg:grid-cols-7">
    {techs.map((tech) => (
      <div
        class="animate-on-scroll rounded-xl border border-white/[0.06] bg-surface-raised p-4 text-center transition-all duration-200 hover:scale-105 hover:border-white/10"
        style={`transition-delay: ${tech.delay}ms;`}
      >
        <div class="text-2xl" aria-hidden="true">{tech.icon}</div>
        <div class="mt-2 text-sm font-semibold text-text-primary">{tech.name}</div>
        <div class="mt-1 text-xs text-text-muted">{tech.role}</div>
      </div>
    ))}
  </div>
</section>
