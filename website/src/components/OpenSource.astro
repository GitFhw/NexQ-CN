---
import { t, type WebsiteLocale } from '../i18n';

interface Props {
  locale: WebsiteLocale;
}

const { locale } = Astro.props;
---

<section class="section-container">
  <div class="text-center">
    <h2 class="section-title">{t('Built in the open', locale)}</h2>
    <p class="section-subtitle mx-auto text-center">
      {t('NexQ is MIT-licensed and always will be. Star us, fork us, contribute.', locale)}
    </p>
  </div>

  <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
    <!-- GitHub Stars -->
    <div class="animate-on-scroll rounded-xl border border-white/[0.06] bg-surface-raised p-8 text-center" style="transition-delay: 0ms;">
      <div class="mb-2 text-sm text-text-muted">{t('GitHub Stars', locale)}</div>
      <img
        src="https://img.shields.io/github/stars/VahidAlizadeh/NexQ?style=for-the-badge&color=333&labelColor=1a1a28"
        alt={t('GitHub Stars', locale)}
        class="mx-auto h-8"
        loading="lazy"
      />
    </div>

    <!-- Commits -->
    <div class="animate-on-scroll rounded-xl border border-white/[0.06] bg-surface-raised p-8 text-center" style="transition-delay: 150ms;">
      <div class="text-3xl font-extrabold text-accent-blue">415+</div>
      <div class="mt-1 text-sm text-text-muted">{t('Commits', locale)}</div>
    </div>

    <!-- License -->
    <div class="animate-on-scroll rounded-xl border border-white/[0.06] bg-surface-raised p-8 text-center" style="transition-delay: 300ms;">
      <div class="text-3xl font-extrabold text-accent-green">{t('MIT Licensed', locale)}</div>
      <div class="mt-1 text-sm text-text-muted">{t('Free forever', locale)}</div>
    </div>
  </div>

  <!-- CTAs -->
  <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
    <a
      href="https://github.com/VahidAlizadeh/NexQ"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary"
    >
      {t('Star on GitHub', locale)}
    </a>
    <a
      href="https://github.com/VahidAlizadeh/NexQ/blob/main/CONTRIBUTING.md"
      target="_blank"
      rel="noopener noreferrer"
      class="btn-secondary"
    >
      {t('Contributing Guide', locale)}
    </a>
  </div>
</section>
